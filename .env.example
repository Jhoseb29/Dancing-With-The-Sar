# Copiar a .env (ignorado por git) y completar. Nunca subir valores reales.

# GAMC · Proyecto 02 "Dancing with the SARs" (https://recursosgamc.cochabamba.bo/api-doc)
GAMC_WMS_KEY=

# NASA Earthdata Login (ingesta en compute-py)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Agente de la UI (fase 2 · ui-agent en compute-py)
GEMINI_API_KEY=
# Vacío = gemini-4-hydrogen (elegido por latencia y uso de herramientas). Respaldo automático: gemini-3.8-flash.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Voz a texto (vacío = gemini-3.5-flash-lite)
GEMINI_STT_MODEL=

# NASA FIRMS (fase 3 · incendios)
FIRMS_MAP_KEY=
# Claude (chat Ecos: entender la pregunta + explicar). Dos formas, mismo resultado:
#   cli  -> Claude Code con tu suscripción (ejecuta `claude` una vez para iniciar sesión)
#   api  -> API de Anthropic con ANTHROPIC_API_KEY (se cobra por uso)
#   auto -> api si hay ANTHROPIC_API_KEY, si no cli
CLAUDE_BACKEND=auto
ANTHROPIC_API_KEY=
# Modelos (alias haiku|sonnet|opus o un id exacto como claude-haiku-5-5)
CLAUDE_INTENT_MODEL=haiku
CLAUDE_INTERPRET_MODEL=haiku
