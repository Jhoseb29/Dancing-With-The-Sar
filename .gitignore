# Environment & secrets (12-Factor: never commit credentials)
.env
.env.*
!.env.example
*.netrc
_netrc

# Geospatial raw & large processed binaries (keep .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/cog/*
!data/processed/cog/.gitkeep
data/processed/zarr/*
!data/processed/zarr/.gitkeep
data/processed/pmtiles/*
!data/processed/pmtiles/.gitkeep
data/processed/tables/*
!data/processed/tables/.gitkeep
data/datasets/*
!data/datasets/.gitkeep

# Node / Angular / TypeScript
node_modules/
dist/
.angular/
*.tsbuildinfo

# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Logs, OS & editors
*.log
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
