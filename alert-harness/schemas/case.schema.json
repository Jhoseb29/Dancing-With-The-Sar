{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dancing-with-the-sars/schemas/case.schema.json",
  "title": "Caso de evaluación",
  "description": "Un evento real (ocurrio=true) o un día sin evento en el mismo lugar (ocurrio=false), con lo que esperamos que diga el harness.",
  "type": "object",
  "required": ["id", "nombre", "bbox", "fecha", "peligro", "ocurrio", "fuente", "esperado"],
  "properties": {
    "id": {"type": "string"},
    "nombre": {"type": "string"},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "fecha": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "precision_fecha": {"type": "string"},
    "peligro": {"enum": ["inundacion", "mazamorra", "deslizamiento"]},
    "ocurrio": {"type": "boolean"},
    "fuente": {"type": "string"},
    "radar_run": {"type": ["string", "null"], "description": "Corrida existente del nisar-harness a reutilizar"},
    "notas": {"type": "string"},
    "esperado": {
      "type": "object",
      "required": ["nivel_min", "nivel_max", "expectativas"],
      "properties": {
        "nivel_min": {"enum": ["verde", "amarillo", "naranja", "rojo"]},
        "nivel_max": {"enum": ["verde", "amarillo", "naranja", "rojo"]},
        "expectativas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["indicador", "op", "valor", "por_que"],
            "properties": {
              "indicador": {"type": "string"},
              "op": {"enum": [">=", "<=", ">", "<", "existe"]},
              "valor": {"type": ["number", "null"]},
              "por_que": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}
