{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "95f7b3b1-9df5-4a23-bb61-e4b213722308"
  },
  "newProjectRoot": "projects",
  "projects": {
    "dancing-with-the-sars": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true,
          "type": "component"
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cesium/Build/Cesium/Workers",
                "output": "cesium/Workers"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cesium/Build/Cesium/Assets",
                "output": "cesium/Assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cesium/Build/Cesium/ThirdParty",
                "output": "cesium/ThirdParty"
              },
              {
                "glob": "**/*",
                "input": "node_modules/cesium/Build/Cesium/Widgets",
                "output": "cesium/Widgets"
              },
              {
                "glob": "{maplibre-gl-worker.mjs,maplibre-gl-shared.mjs,maplibre-gl.css}",
                "input": "node_modules/maplibre-gl/dist",
                "output": "maplibre"
              }
            ],
            "styles": [
              "node_modules/@fontsource/barlow/400.css",
              "node_modules/@fontsource/barlow/700.css",
              "src/styles.scss"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "allowedCommonJsDependencies": [
              "mersenne-twister",
              "urijs",
              "protobufjs",
              "lerc",
              "bitmap-sdf",
              "grapheme-splitter",
              "nosleep.js",
              "ajv",
              "fast-deep-equal",
              "json-schema-traverse",
              "fast-uri"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "360kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dancing-with-the-sars:build:production"
            },
            "development": {
              "buildTarget": "dancing-with-the-sars:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          }
        }
      }
    }
  }
}